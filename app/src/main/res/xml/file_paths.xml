<?xml version="1.0" encoding="utf-8"?>
<!-- Cache folders the app hands to other apps through its FileProvider. -->
<paths>
    <!-- A photo the camera app writes for the composer. -->
    <cache-path name="camera_captures" path="camera-captures/" />
    <!-- A rendered profile image shared out. -->
    <cache-path name="shared_profile" path="shared-profile/" />
</paths>
