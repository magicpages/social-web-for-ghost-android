<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked once from the notifications tab, so background checks can announce new notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (Android 11+): lets the composer see whether any app can take a photo, to show its camera button. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Backup and device transfer are off: stored credentials are encrypted with a Keystore key that can't move. -->
    <application
        android:name=".SocialWebApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SocialWeb">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the launcher icon: new note and notifications. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Share target: a link, or text selected on a page with its link, opens a new note. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Share target: one image, with or without text, opens a new note with it attached. No SEND_MULTIPLE: a note takes one image. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/gif" />
            </intent-filter>
        </activity>

        <!--
            Share target: a link opens in the app (a post's thread, or a profile) instead of a new note. An alias of
            MainActivity, so the share sheet lists it with its own label; MainActivity tells the two apart by the
            component the intent was sent to (MainActivity.OpenLinkAlias).
        -->
        <activity-alias
            android:name=".OpenLinkAlias"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/share_open_in_app"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- A Ghost site's Portal in a web view that keeps the member session. It handles its own configuration changes so the page survives rotation. -->
        <activity
            android:name=".ui.browser.MemberBrowserActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The Like and Reply buttons on system notifications; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".background.NotificationActionReceiver"
            android:exported="false" />

        <!-- WorkManager is initialised by SocialWebApp (Configuration.Provider) so Hilt can build workers; the other startup initializers stay. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Hands cache files to other apps: the camera app writes composer photos here, and rendered images are shared from it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
