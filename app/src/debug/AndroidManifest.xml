<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Demo mode (debug builds only): starts before the application and watches for the launch flag. -->
        <provider
            android:name=".demo.DemoModeProvider"
            android:authorities="${applicationId}.demo"
            android:exported="false" />

        <!-- Posts the demo account's reply and mention as system notifications. Exported for adb's
             broadcast; DUMP is held by the shell, never by other apps. It does nothing outside demo mode. -->
        <receiver
            android:name=".demo.DemoNotificationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
